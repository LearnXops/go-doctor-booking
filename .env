# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doctor_booking
DB_HOST=db
DB_PORT=5432

# API Configuration
JWT_SECRET=your_jwt_secret_key_here
ENV=development

# Frontend Configuration
NODE_ENV_PROD=production
NODE_ENV_DEV=development
VITE_API_BASE_URL_PROD=/api/v1
VITE_API_BASE_URL_DEV=http://localhost:8080/api/v1

# Ports
DB_PORT_EXPOSE=5432
API_PORT_EXPOSE=8080
FRONTEND_PROD_PORT=8081
FRONTEND_DEV_PORT=5173
